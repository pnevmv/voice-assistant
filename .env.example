# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# --- shared ---
LOG_LEVEL=info              # debug|info|warn|error
LOG_FORMAT=text             # json in production, text for local dev
SHUTDOWN_TIMEOUT=20s
DATABASE_URL=postgres://unipd:unipd@localhost:5432/unipd?sslmode=disable
OTEL_EXPORTER_OTLP_ENDPOINT=   # e.g. http://localhost:4317 (start the "tracing" compose profile)

# docker compose postgres
POSTGRES_USER=unipd
POSTGRES_PASSWORD=unipd
POSTGRES_DB=unipd

# --- listen addresses (defaults shown) ---
GATEWAY_HTTP_ADDR=:8081
RAG_HTTP_ADDR=:8082
VOICE_HTTP_ADDR=:8083
CRAWLER_HTTP_ADDR=:8084

# --- gateway ---
GATEWAY_CONFIG_FILE=config/gateway.example.yaml   # model aliases, provider chains, prices
OPENAI_API_KEY=                                   # any OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- clients of the gateway (rag, crawler, voice, eval) ---
GATEWAY_URL=http://localhost:8081

# --- rag ---
RAG_URL=http://localhost:8082
RAG_CURRENT_ACADEMIC_YEAR=2026/27
RAG_INDEXER_ENABLED=true
INDEXER_LEASE_TIMEOUT=10m      # a version stuck in 'indexing' longer than this can be reclaimed
INDEXER_MAX_ATTEMPTS=5         # then index_status='failed' + alert
INDEXER_BACKOFF_BASE=30s       # retry delay = base * 2^(attempts-1), capped at INDEXER_BACKOFF_MAX
INDEXER_BACKOFF_MAX=30m
INDEXER_HEARTBEAT=2m           # lease is extended this often while a version is being processed

# --- crawler ---
CRAWLER_CONFIG_FILE=config/crawler.example.yaml   # hosts, path allowlist, seeds, recrawl intervals (no secrets)
CRAWLER_ALLOWED_HOSTS=www.unipd.it,wwwassets.unipd.it   # hard allowlist; ESU Padova is out of scope (ADR-0010)
CRAWLER_USER_AGENT=UniPDAssistantBot/0.1 (+contact: you@example.com)
CRAWLER_RATE_PER_HOST=1s               # min delay between requests to one host
DATA_DIR=./data

# --- voice ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# STT. M5 uses batch scribe_v3. scribe_v3_live (realtime, WebSocket) is the later latency optimisation.
# (scribe_v1 is deprecated: do not use.)
ELEVENLABS_STT_MODEL=scribe_v3
ELEVENLABS_STT_REALTIME_MODEL=scribe_v3_live   # not used before the realtime work; kept so the switch is config-only
ELEVENLABS_KEYTERMS_FILE=config/keyterms.txt   # validated at startup against the realtime limits
ELEVENLABS_STT_KEYTERMS=true                   # false = send no keyterms (eval: WER with vs without; they are billed extra)
VOICE_ALLOW_OVERRIDES=false                    # true only for dev/eval: allows per-request keyterms / tts_model overrides
# TTS. Primary and fallback are both configurable so eval can compare time-to-first-audio.
# The fallback is used when the primary fails before the first audio byte.
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
ELEVENLABS_TTS_FALLBACK_MODEL=eleven_flash_v2_5
